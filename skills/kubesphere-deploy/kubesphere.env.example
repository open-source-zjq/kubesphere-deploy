# ---------------------------------------------------------------------------
# kubesphere-deploy configuration
#
# Copy this file to `kubesphere.env` and fill in your values:
#     cp kubesphere.env.example kubesphere.env
#
# `kubesphere.env` is gitignored. NEVER commit real credentials.
# All KS_* values can also be exported as environment variables instead.
# ---------------------------------------------------------------------------

# ---- Cluster endpoint (required) ----
# Base URL of the ks-apiserver / console gateway. No trailing slash needed.
# Examples: https://kubesphere.example.com   or   http://203.0.113.10:30880
KS_URL=https://kubesphere.example.com

# Set to 1 to allow self-signed / untrusted TLS certificates (curl -k).
# KS_INSECURE=1

# Optional: target a specific member cluster in a multi-cluster setup.
# KS_CLUSTER=host

# ---- Credentials (pick ONE method; checked in this order) ----
#
# Method 1 (recommended for CI / automation): a bearer token.
#   Obtain from a ServiceAccount/kubeconfig, or from `/oauth/token`.
# KS_TOKEN=

# Method 2 (recommended for interactive use): username + plaintext password.
#   Uses the OAuth2 password grant (POST /oauth/token). Requires the OAuth
#   client to be "Trusted" (the default in KubeSphere).
KS_USERNAME=<your-username>
# KS_PASSWORD=<your-password>

# Method 3 (legacy fallback): username + the console-encrypted password.
#   This is the `encrypt` field the KubeSphere console sends to POST /login.
#   Only needed if the OAuth password grant is disabled on your cluster.
#   Grab it from your browser DevTools: Network -> /login request -> payload.
# KS_ENCRYPT=

# Optional OAuth client overrides (defaults are both "kubesphere").
# KS_OAUTH_CLIENT_ID=kubesphere
# KS_OAUTH_CLIENT_SECRET=kubesphere

# ---- Workspace / DevOps project / pipeline defaults ----
# Workspace that holds the DevOps project.
KS_WORKSPACE=<your-workspace>

# How to locate the DevOps project. Use ONE of:
#   - KS_DEVOPS: the exact metadata.name (often has a random suffix, e.g.
#     my-devops-abc12). Fastest, skips lookup.
#   - KS_DEVOPS_GENERATE_NAME: the friendly name you typed in the UI; the
#     skill resolves it to the real metadata.name by matching generateName.
# KS_DEVOPS=
KS_DEVOPS_GENERATE_NAME=<your-devops-project>

# Default pipeline to run when none is given on the command line.
KS_PIPELINE=<your-pipeline>

# ---- Default pipeline parameters ----
# Any KS_PARAM_<NAME> is used as the default value for pipeline parameter
# <NAME> (overridden by --<NAME>=... on the command line). Empty = unset.
# The parameter names must match your pipeline's parameter definitions.
# KS_PARAM_REGISTRY=registry.example.com
# KS_PARAM_PROJECT_NAMESPACE=<your-namespace>
# KS_PARAM_APP_NAME=
# KS_PARAM_POD_COUNT=1

# Set to 1 to skip the dry-run confirmation and submit immediately.
# Leave unset so `run` prints the payload first (safer).
# KS_ASSUME_YES=1
